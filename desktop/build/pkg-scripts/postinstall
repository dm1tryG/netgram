#!/bin/bash
# Runs as root at the end of the .pkg install: put the `netgram` CLI in PATH by
# symlinking to the binary inside the app bundle (same pattern as Docker's CLI).
set -e
APP="/Applications/NetGram.app"
CLI="$APP/Contents/Resources/netgram"
DEST="/usr/local/bin/netgram"

if [ -f "$CLI" ]; then
  mkdir -p /usr/local/bin
  ln -sfh "$CLI" "$DEST"
fi
exit 0
